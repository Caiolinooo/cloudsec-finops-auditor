# Runtime de POST /api/v1/audit. O build não exige a chave.
GEMINI_API_KEY=

# Opcional. Default: gemini-2.5-flash / gemini-2.0-flash
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.0-flash

# Opcional. Se definido, POST /api/v1/audit exige Authorization: Bearer <token>
# ou x-audit-token. Sem isso o console público continua funcionando, com rate limit.
AUDIT_ACCESS_TOKEN=
