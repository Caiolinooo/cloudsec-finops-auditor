# Runtime de POST /api/v1/audit. O build não exige a chave.
GEMINI_API_KEY=

# Opcional. Default: gemini-3.8-flash / gemini-3.6-flash
# Para forçar Pro: GEMINI_MODEL=gemini-3.1-pro-preview
#                   GEMINI_FALLBACK_MODEL=gemini-3.1-pro-preview
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
