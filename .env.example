# Required at runtime for POST /api/v1/audit (build succeeds without it)
GEMINI_API_KEY=

# Optional — pin / override models (flash-class)
# Primary (documented default): gemini-2.5-flash
# Fallback if the primary model is unavailable: gemini-2.0-flash
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.0-flash
